{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}\"/hooks/macaw-cx-audit.sh session_start observe",
            "timeout": 10,
            "async": false
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}\"/hooks/macaw-cx-gate.sh prompt observe",
            "timeout": 480,
            "async": false
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}\"/hooks/macaw-cx-gate.sh tool observe",
            "timeout": 480,
            "async": false
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}\"/hooks/macaw-cx-audit.sh post_tool observe",
            "timeout": 10,
            "async": false
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}\"/hooks/macaw-cx-audit.sh session_end observe",
            "timeout": 3,
            "async": false
          }
        ]
      }
    ]
  }
}
